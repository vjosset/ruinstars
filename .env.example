# Database connection string (adjust username, password, host, db name)
DATABASE_URL="mysql://user:pass@host:3306/ruinstars"

# Used by NextAuth.js
# In production, set this to the public URL served by the reverse proxy (e.g. https://ruinstars.com)
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:5000"

# Local uploads (squad/unit portraits) - must be writable by the app
UPLOADS_DIR=/path/to/user/uploads

# Feature flags
NEXT_PUBLIC_FEATURE_BATTLES=false
NEXT_PUBLIC_FEATURE_CAMPAIGNS=false
